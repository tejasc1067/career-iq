# CareerIQ API configuration. Copy to `.env` and adjust for your machine.
# Placeholder values only — never commit real secrets.

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Must use an async-capable driver.
DATABASE_URL=postgresql+psycopg://careeriq:careeriq@localhost:5432/careeriq
DATABASE_ECHO=false

# Browser origins allowed to call the API directly (JSON list).
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Not wired up yet. Listed here so the shape is known in advance. ---
# Authentication (ARCHITECTURE.md sections 9-11)
# JWT_SECRET=replace-with-a-long-random-value
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
#
# Local AI (ARCHITECTURE.md sections 18-19, 23)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=replace-with-model-name
# EMBEDDING_MODEL=replace-with-embedding-model-name
